<idea-plugin>
    <id>com.github.baenar.harnessaside</id>
    <name>Harness Aside</name>
    <vendor>baenar</vendor>
    <description><![CDATA[
        Runs AI coding harnesses (Claude Code, Antigravity CLI, OpenCode) in a dedicated terminal tool window, docked on the right.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Harness Aside"
                    anchor="right"
                    icon="/icons/manul-default.svg"
                    factoryClass="com.github.baenar.harnessaside.HarnessToolWindowFactory"/>
        <notificationGroup id="Harness Aside" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="HarnessAside.SendSelection"
                class="com.github.baenar.harnessaside.SendSelectionToHarnessAction"
                text="Send to Harness Aside"
                description="Insert a reference to this file and selection into the active harness terminal">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
