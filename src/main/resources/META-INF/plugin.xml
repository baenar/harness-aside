<idea-plugin>
    <id>com.github.baenar.claudeaside</id>
    <name>Claude Aside</name>
    <vendor>baenar</vendor>
    <description><![CDATA[
        Runs Claude Code in a dedicated terminal tool window, docked on the right.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.plugins.terminal</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Claude Aside"
                    anchor="right"
                    icon="/icons/claudeAside.svg"
                    factoryClass="com.github.baenar.claudeaside.ClaudeToolWindowFactory"/>
    </extensions>

</idea-plugin>
