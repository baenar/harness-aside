{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://127.0.0.1:$HARNESS_IDE_PORT/status?state=idle&token=$HARNESS_IDE_TOKEN\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://127.0.0.1:$HARNESS_IDE_PORT/status?state=thinking&token=$HARNESS_IDE_TOKEN\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://127.0.0.1:$HARNESS_IDE_PORT/status?state=tool&token=$HARNESS_IDE_TOKEN\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://127.0.0.1:$HARNESS_IDE_PORT/status?state=thinking&token=$HARNESS_IDE_TOKEN\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
