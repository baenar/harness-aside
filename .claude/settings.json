      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://127.0.0.1:$HARNESS_IDE_PORT/status?state=waiting&token=$HARNESS_IDE_TOKEN\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST \"http://127.0.0.1:$HARNESS_IDE_PORT/status?state=waiting&token=$HARNESS_IDE_TOKEN\" >/dev/null 2>&1 || true"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "hooks": [
